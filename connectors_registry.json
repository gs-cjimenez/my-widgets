{
  "connectors": [
    {
      "name": "Community Cases — List",
      "permalink": "community-cases-list",
      "url": "https://api2-us-west-2.insided.com/v2/categories/37/topics",
      "method": "GET",
      "headers": [
        { "key": "Accept", "value": "application/json", "overridable": false }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_id') }}",
          "client_secret": "{{ get_secret('cc_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read write"
        }
      }
    },
    {
      "name": "Community Cases — Create",
      "permalink": "community-cases-create",
      "url": "https://api2-us-west-2.insided.com/v2/questions/ask?authorId={{ user.id }}",
      "method": "POST",
      "headers": [
        { "key": "Content-Type", "value": "application/json", "overridable": false },
        { "key": "Accept",       "value": "application/json", "overridable": false }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_id') }}",
          "client_secret": "{{ get_secret('cc_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read write"
        }
      },
      "request_body": "{{ body_text }}"
    },
    {
      "name": "Community Cases — Add Reply",
      "permalink": "community-cases-add-reply",
      "url": "https://api2-us-west-2.insided.com/v2/questions/{{ pathParams.topicId }}/reply?authorId={{ user.id }}",
      "method": "POST",
      "headers": [
        { "key": "Content-Type", "value": "application/json", "overridable": false },
        { "key": "Accept",       "value": "application/json", "overridable": false }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_id') }}",
          "client_secret": "{{ get_secret('cc_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read write"
        }
      },
      "request_body": "{{ body_text }}"
    },
    {
      "name": "Spotlight Users",
      "url": "https://api2-us-west-2.insided.com/user?filter[roles.rolename][]=Spotlight&include[]=roles&limit=50",
      "method": "GET",
      "headers": [
        { "key": "Accept", "value": "application/json", "overridable": false }
      ],
      "authentication": {
        "type": "oauth_client_credentials",
        "config": {
          "client_id": "{{ get_secret('cc_id') }}",
          "client_secret": "{{ get_secret('cc_secret') }}",
          "token_url": "https://api2-us-west-2.insided.com/oauth2/token",
          "scope": "read write"
        }
      },
      "permalink": "spotlight-users"
    }
  ]
}
